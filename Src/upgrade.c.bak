int longitud(char cadena[])
{
  int i;

  for (i = 0; cadena[i] != '\0'; i++)
    ;
  return i;
}

char concatena(char cadena1[], char cadena2[])
{
  char i, j, k;

  j = longitud(cadena1);
  k = longitud(cadena2);

  for (i = 0; i <= k; i++)
  {
    cadena1[j + i] = cadena2[i];
  }
  return (j + k);
}

void copiar(char cadena1[], char cadena2[])
{
  char i, k;

  k = longitud(cadena2);

  for (i = 0; i <= k; i++)
  {
    cadena1[i] = cadena2[i];
  }
}

