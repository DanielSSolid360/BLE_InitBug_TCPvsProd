//				HAL_GPIO_WritePin(GPIOB, RL2_Pin, GPIO_PIN_RESET);
//				HAL_GPIO_WritePin(GPIOA, RL3_Pin, GPIO_PIN_RESET);
//				HAL_GPIO_WritePin(GPIOA, RL4_Pin, GPIO_PIN_RESET);
