//						strcpy((void *)buffer_out, "^Rele1 Off\r\n$");
//					}
//				else if (param3[0]=='1')
//					{
//						HAL_GPIO_WritePin(GPIOB, RL1_Pin, GPIO_PIN_SET);
//						strcpy((void *)buffer_out, "^Rele1 On\r\n$");
//					}
//				else strcpy((void *)buffer_out, "^ERROR nivel 3 (.REL 1 0/1)\r\n$");
//				}
//			
//			else if (param2[0]=='2')
//				{
